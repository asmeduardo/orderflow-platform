# Local development only. Copy to .env (ignored by Git) and choose your own values.
POSTGRES_DB=orderflow
POSTGRES_USER=orderflow
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Local authorization server (dev-auth-server). Pick any long random values.
ORDERFLOW_READER_CLIENT_SECRET=
ORDERFLOW_OPERATOR_CLIENT_SECRET=

# Kafka host port (the services read KAFKA_BOOTSTRAP_SERVERS, default localhost:9092).
KAFKA_PORT=9092
